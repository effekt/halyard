{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "versioning": "prerelease",
  "prerelease": true,
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(repo): release ${branch}",
  "last-release-sha": "8de65eff7d12ab4ee4a1e2179654aaf04d734245",
  "packages": {
    "packages/core": {
      "component": "core",
      "prerelease-type": "rc",
      "extra-files": ["src/version.constants.ts"]
    },
    "packages/next": { "component": "next", "prerelease-type": "rc" },
    "packages/react": { "component": "react", "prerelease-type": "rc" },
    "packages/store-fs": { "component": "store-fs", "prerelease-type": "rc" }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "nubbin",
      "components": ["core", "next", "react", "store-fs"],
      "merge": false
    }
  ]
}
