{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // A published library's dead exports are worse than an app's: they ship, they get
  // depended on, and semver then protects them forever. Knip is the gate that stops an
  // export reaching the surface before anything needs it.
  "ignore": ["**/*.d.ts", ".claude/**", "**/.next/**"],

  // Tooling for a package that has not been written yet. Each is wired into a gate that
  // runs the moment the first package exists, and deleting them now would mean rediscovering
  // the same set later. Delete an entry here when the tool starts being reached for real.
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "@commitlint/types"],

  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "commitlint.config.mjs", ".dependency-cruiser.cjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "examples/*": {
      "entry": [
        "src/app/**/{page,layout,not-found,error,loading,route}.{ts,tsx}",
        "next.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  }
}
