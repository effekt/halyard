{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // A published library's dead exports are worse than an app's: they ship, they get
  // depended on, and semver then protects them forever. Knip is the gate that stops an
  // export reaching the surface before anything needs it.
  "ignore": ["**/*.d.ts", ".claude/**"],

  // publint and attw check a published package, so they are unreachable until one exists,
  // and both are already wired into the gate table. @commitlint/types is a type-only import
  // in the commitlint config. tailwindcss is reached from `@import "tailwindcss"` in
  // globals.css, which knip does not follow out of a stylesheet.
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "@commitlint/types", "tailwindcss"],

  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    // `fixtures/` and `scripts/` sit outside `src/`, so knip cannot see them at all without
    // being told — and a file it cannot see is one it can neither report nor count as the
    // reason another file is reachable. Entries stay as they were: knip finds the publish
    // script through the `fixtures:publish` package script and the suites through
    // `vitest.config.ts`, and naming either again is reported as a redundant pattern.
    "examples/*": {
      "entry": ["src/app/**/{page,layout,not-found,error,loading,route}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "fixtures/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  }
}
