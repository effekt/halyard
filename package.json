{
  "name": "nubbin",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Your components. Their pages. A page builder that lives inside your codebase.",
  "keywords": [
    "page-builder",
    "cms",
    "schema",
    "standard-schema",
    "content-management",
    "react",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Jesse Wheeler (https://github.com/effekt)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effekt/nubbin.git"
  },
  "homepage": "https://github.com/effekt/nubbin#readme",
  "bugs": {
    "url": "https://github.com/effekt/nubbin/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "dupes": "jscpd packages",
    "knip": "knip",
    "boundaries": "node -e \"const{existsSync}=require('node:fs');const d=['packages','apps','examples'].filter(existsSync);if(!d.length){console.log('no source directories yet');process.exit(0)}require('node:child_process').execFileSync('pnpm',['exec','depcruise',...d,'--config','.dependency-cruiser.cjs'],{stdio:'inherit'})\"",
    "type-coverage": "type-coverage --project tsconfig.type-coverage.json --at-least 99 --strict --ignore-files \"**/*.test.ts\" --detail",
    "single-export": "node scripts/check-single-export.mjs --check",
    "junk-filenames": "node scripts/check-structure.mjs --check",
    "rule-files": "node scripts/check-rules.mjs --check",
    "schema-depth": "node scripts/check-schema-depth.mjs --check",
    "vendor-refs": "node scripts/check-no-vendor-refs.mjs --check",
    "docs": "node scripts/check-docs.mjs --check",
    "prose": "node scripts/check-prose.mjs --check",
    "a11y": "node scripts/check-a11y.mjs --check",
    "stale-docs": "node scripts/check-stale-docs.mjs",
    "catalog": "node scripts/docs-catalog.mjs",
    "pinned-deps": "node scripts/check-pinned-deps.mjs --check",
    "skills-lock": "node scripts/check-skills-lock.mjs --check",
    "publint": "pnpm --filter \"./packages/*\" exec publint",
    "attw": "attw --pack packages/core --profile esm-only",
    "tarball": "node scripts/check-tarball.mjs --check",
    "publishable": "turbo run build && pnpm publint && pnpm attw && pnpm tarball",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs && pnpm prose && pnpm a11y && pnpm vendor-refs && pnpm pinned-deps && pnpm skills-lock && pnpm junk-filenames && pnpm rule-files && pnpm schema-depth && pnpm single-export && pnpm dupes && pnpm knip && pnpm boundaries && pnpm type-coverage && pnpm publishable",
    "map": "repomix --style json --output .repomix/codebase.json",
    "map:docs": "node scripts/docs-catalog.mjs --json > .repomix/docs.json",
    "release": "pnpm publishable && changeset publish",
    "release:rc": "pnpm publishable && pnpm --filter \"./packages/*\" publish --tag rc --no-git-checks",
    "changeset": "changeset",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "publint": "catalog:",
    "repomix": "catalog:",
    "turbo": "catalog:",
    "type-coverage": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
