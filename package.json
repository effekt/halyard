{
  "name": "nubbin",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "warn"
    }
  },
  "description": "Your components. Their pages. A page builder that lives inside your codebase.",
  "keywords": [
    "page-builder",
    "cms",
    "schema",
    "standard-schema",
    "content-management",
    "react",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Jesse Wheeler (https://github.com/effekt)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effekt/nubbin.git"
  },
  "homepage": "https://github.com/effekt/nubbin#readme",
  "bugs": {
    "url": "https://github.com/effekt/nubbin/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test && vitest run --project repo",
    "test:release": "vitest run --project release",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prose": "node scripts/check-prose.mjs --check",
    "a11y": "node scripts/check-a11y.mjs --check",
    "pinned-deps": "syncpack lint",
    "dupes": "jscpd packages",
    "knip": "knip",
    "boundaries": "node -e \"const{existsSync}=require('node:fs');const d=['packages','apps','examples'].filter(existsSync);if(!d.length){console.log('no source directories yet');process.exit(0)}require('node:child_process').execFileSync('pnpm',['exec','depcruise',...d,'--config','.dependency-cruiser.cjs'],{stdio:'inherit'})\"",
    "type-coverage": "type-coverage --project tsconfig.type-coverage.json --at-least 99 --strict --ignore-files \"**/*.test.ts?(x)\" --detail",
    "core-version": "vitest run tests/coreVersionStamp.test.mjs",
    "publint": "pnpm --filter \"./packages/*\" exec publint",
    "attw": "pnpm --filter \"./packages/*\" exec attw --pack . --profile esm-only",
    "publishable": "pnpm core-version && turbo run build && pnpm publint && pnpm attw && pnpm test:release",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm prose && pnpm a11y && pnpm pinned-deps && pnpm dupes && pnpm knip && pnpm boundaries && pnpm type-coverage && pnpm publishable",
    "catalog": "node scripts/catalog.mjs",
    "sync-version": "node scripts/sync-core-version.mjs",
    "skills:install": "node scripts/installAgentSkills.mjs",
    "skills:record": "node scripts/record-skills-lock.mjs",
    "issue-scaffold": "node scripts/scaffold-issue.mjs",
    "worktree-check": "node scripts/check-worktree.mjs --check",
    "primary-tree": "node scripts/check-primary-tree.mjs --check",
    "release-tag": "node scripts/check-release-tag.mjs --check",
    "release": "pnpm publishable && pnpm release-tag && changeset publish",
    "release:rc": "pnpm publishable && pnpm --filter \"./packages/*\" publish --tag rc --no-git-checks",
    "changeset": "changeset",
    "prepare": "git config core.hooksPath .githooks && lefthook install --force || true; node scripts/catalog.mjs || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "publint": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "type-coverage": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
