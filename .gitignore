node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo
.DS_Store

.env
.env.local
.env.*.local

coverage/
.nubbin/

# Generated by `scripts/catalog.mjs` on every install. A committed index changes on every
# file added or renamed, so parallel branches collide on it constantly and the resolution is
# always "regenerate" — a conflict carrying no information.
#
# Anchored to the directories the generator writes, not a bare `CATALOG.md`. git sets
# `core.ignorecase=true` on a case-insensitive filesystem, and it applies that to ignore
# patterns too: the unqualified form matched the tracked `docs/reference/catalog.md` on macOS
# and dropped it from a commit, while every local check passed because the file was still on
# disk. A Linux runner then failed on a document that no longer existed.
/packages/*/CATALOG.md
/apps/*/CATALOG.md
/.claude/CATALOG.md

# jscpd report output
report/

# Skills the CLI installs into the project. The content is third-party and not ours to
# redistribute, so it is ignored the way node_modules is — skills-lock.json is committed
# instead, and records the source, path and content hash needed to reinstall the same set.
# The skills written here are ours and stay tracked, one exception each.
/.agents/
/.claude/skills/*
!/.claude/skills/decision/
!/.claude/skills/issue/
!/.claude/skills/querying-github/
!/.claude/skills/worktree/

# Agent worktrees. Inside the repository so a stray `rm -rf /tmp` cannot take uncommitted
# work with it, and ignored because a worktree is a checkout, not content.
.worktrees/

# Docusaurus generated state (apps/docs)
.docusaurus/

# Playwright MCP writes console logs and traces beside whatever it is driving.
.playwright-mcp/

# The vendor scrub list stays private even though the gate that read it is gone: the
# terms are the thing being protected, not the check that read them. One term per line.
scripts/vendor-terms.txt
