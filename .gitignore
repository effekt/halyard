node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo
.DS_Store

.env
.env.local
.env.*.local

coverage/
.nubbin/

# Generated on demand by `pnpm map` — a committed codebase map goes stale and
# conflicts on every branch that adds a unit.
.repomix/

# jscpd report output
report/

# Vendor scrub list — kept private; see vendor-terms.example.txt
scripts/vendor-terms.txt

# Skills the CLI installs into the project. The content is third-party and not ours to
# redistribute, so it is ignored the way node_modules is — skills-lock.json is committed
# instead, and records the source, path and content hash needed to reinstall the same set.
# The decision skill is ours and stays tracked.
/.agents/
/.claude/skills/*
!/.claude/skills/decision/

# Agent worktrees. Inside the repository so a stray `rm -rf /tmp` cannot take uncommitted
# work with it, and ignored because a worktree is a checkout, not content.
.worktrees/
