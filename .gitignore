node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo
.DS_Store

.env
.env.local
.env.*.local

coverage/
.nubbin/

# jscpd report output
report/

# Skills the CLI installs into the project. The content is third-party and not ours to
# redistribute, so it is ignored the way node_modules is — skills-lock.json is committed
# instead, and records the source, path and content hash needed to reinstall the same set.
# The skills written here are ours and stay tracked, one exception each.
/.agents/
/.claude/skills/*
!/.claude/skills/decision/
!/.claude/skills/issue/
!/.claude/skills/querying-github/
!/.claude/skills/worktree/

# Agent worktrees. Inside the repository so a stray `rm -rf /tmp` cannot take uncommitted
# work with it, and ignored because a worktree is a checkout, not content.
.worktrees/

# Docusaurus generated state (apps/docs)
.docusaurus/

# Playwright MCP writes console logs and traces beside whatever it is driving.
.playwright-mcp/

# The vendor scrub list stays private even though the gate that read it is gone: the
# terms are the thing being protected, not the check that read them. One term per line.
scripts/vendor-terms.txt
