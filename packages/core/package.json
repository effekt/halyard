{
  "name": "@nubbin/core",
  "version": "0.1.0-rc.1",
  "description": "The Nubbin contract: define blocks, split catalog from registry, and compile a page document into an immutable artifact.",
  "keywords": [
    "nubbin",
    "page-builder",
    "cms",
    "standard-schema",
    "content"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effekt/nubbin.git",
    "directory": "packages/core"
  },
  "homepage": "https://effekt.github.io/nubbin/",
  "bugs": "https://github.com/effekt/nubbin/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
