{
  "name": "@nubbin/react",
  "version": "0.1.0-rc.5",
  "description": "The React render path for Nubbin: render a compiled artifact against a block registry.",
  "keywords": [
    "nubbin",
    "react",
    "page-builder",
    "cms",
    "server-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effekt/nubbin.git",
    "directory": "packages/react"
  },
  "homepage": "https://effekt.github.io/nubbin/",
  "bugs": "https://github.com/effekt/nubbin/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nubbin/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
