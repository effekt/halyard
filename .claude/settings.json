{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-check-file.mjs",
            "timeout": 60,
            "statusMessage": "Checking structure"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-worktree.mjs --hook",
            "timeout": 15,
            "statusMessage": "Checking worktree"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-primary-tree.mjs --hook",
            "timeout": 15,
            "statusMessage": "Reading primary worktree"
          }
        ]
      }
    ]
  }
}
