{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!.claude",
      "!**/*.grit"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "plugins": [
    "./scripts/biome-plugins/noUnknownCast.grit",
    "./scripts/biome-plugins/booleanNaming.grit"
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true,
            "skipIifes": true
          }
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noMagicNumbers": "error",
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 200,
            "skipBlankLines": true
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "conventions": [
              {
                "selector": {
                  "kind": "variable"
                },
                "match": "_|.{2,}"
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": ".*"
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "match": ".*"
              }
            ]
          }
        },
        // filename === export. Held alongside `tests/oneUnitPerFile.test.mjs` and
        // `tests/junkDrawerFilenames.test.mjs`, this makes filename → symbol invertible,
        // which is what `scripts/catalog.mjs` derives every CATALOG.md from.
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["export"]
          }
        }
      },
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // Exempts the inert studio subtree, whose canonical markup trips these rules.
      // Biome cannot scope inside a file, so the interactive card is exempt too;
      // its accessibility coverage is the recorded accesslint runs, not lint.
      // noNoninteractiveTabindex: the wordmark is a focus-disclosure trigger — the
      // ticket requires tab to reach it and reveal the dictionary entry.
      "includes": ["apps/site/index.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "noNoninteractiveTabindex": "off",
            "useHeadingContent": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.*", "**/*.d.ts", "packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.types.ts", "**/*.constants.ts", "**/*.block.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.schema.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 60,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      // Narrowed from a blanket `scripts/**` exemption, and what stayed has a reason each.
      // `useFilenamingConvention` is `filenameCases: ["export"]`, which an executable entry point
      // cannot satisfy: it exports nothing, so there is no name for the file to match — 15 of the
      // 24 diagnostics the blanket form was hiding were this one rule against that shape.
      // `noExcessiveLinesPerFile` covers `scaffold-issue.mjs` at 586 lines, which is a real
      // decomposition and is tracked as one. `noMagicNumbers` and `noExcessiveLinesPerFunction`
      // were dropped from the exemption and the five violations under them fixed.
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "**/__tests__/**", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error",
            "noEmptyBlockStatements": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useFilenamingConvention": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**/page.tsx",
        "**/app/**/layout.tsx",
        "**/app/**/loading.tsx",
        "**/app/**/error.tsx",
        "**/app/**/not-found.tsx",
        "**/app/**/route.ts",
        "**/app/**/template.tsx",
        "**/app/**/default.tsx",
        "**/*.cjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
